# Copy to .env locally. Never commit .env or keypairs.

# Helius full URL (API key in the URL). Code fallback: https://api.devnet.solana.com
SOLANA_RPC_URL=
SOLANA_WS_URL=

API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_API_URL=http://127.0.0.1:8787
NEXT_PUBLIC_DOCS_URL=http://127.0.0.1:3001
PORT=8787
MARKOV_LEDGER=data/ledger.json
WEB_ORIGIN=http://127.0.0.1:3000

# Bind. Empty = 127.0.0.1. Public/Railway: HOST=0.0.0.0
HOST=

# Required for any reverse-proxy or public bind. Empty for local loopback demo.
MARKOV_API_SECRET=

# Optional. Without this, the bot is CLI-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
BOT_ACTOR=bot_emergency
# Comma-separated Telegram chat ids allowed to /pause and /revoke. Required on a public bot.
TELEGRAM_ALLOWED_CHAT_IDS=
# Opt-in only. Do not set on a public bot.
TELEGRAM_ALLOW_FIRST_CHAT=
# Railway owns getUpdates for markov_float_bot. Loopback does not poll unless TELEGRAM_POLL=1
# (use a separate test-bot token). Set TELEGRAM_POLL=0 to force off.
TELEGRAM_POLL=

# Indexer / data-api (server-side). Never NEXT_PUBLIC_. Railway Postgres.
DATABASE_URL=
INDEXER_SQLITE=data/indexer.sqlite
INDEXER_URL=http://127.0.0.1:8790
INDEXER_FROM_SLOT=0
INDEXER_MAX_LAG_SLOTS=128
MARKOV_PROGRAM_ID=

# Docs site (build-time, public). Local default is loopback data-api.
RECEIPTS_API_URL=http://127.0.0.1:8788
FLOAT_URL=http://127.0.0.1:3000

# Hosted bot pause/revoke signer. JSON byte array. Never commit.
EMERGENCY_KEY_JSON=
